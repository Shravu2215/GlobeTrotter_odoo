# ⚠️ WINDOWS PRISMA FIX (learned from AssetFlow pain):
# - DATABASE_URL must have NO quotes, NO trailing spaces, NO line breaks.
# - Use 127.0.0.1 instead of "localhost" if Prisma throws
#   "the URL must start with the protocol postgresql://" or datasource errors.
# - Make sure .env sits at backend/ root (same level as package.json / prisma folder).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/hackathon_db?schema=public"

PORT=5000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
